        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf löschen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar histórico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を消去"
          }
        }
      }
    },
    "This removes messages from this device.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los mensajes de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages seront supprimés de cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachrichten werden von diesem Gerät entfernt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens serão removidas deste dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末からメッセージが削除されます。"
          }
        }
      }
    },
    "I can summarize your balances, upcoming bills, open chores, and this month's spending. All answers stay on this device.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedo resumir tus saldos, próximas facturas, tareas pendientes y gastos del mes. Las respuestas permanecen en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux résumer vos soldes, factures à venir, tâches en cours et dépenses du mois. Les réponses restent sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann deine Salden, anstehenden Rechnungen, offenen Aufgaben und Monatsausgaben zusammenfassen. Alle Antworten bleiben auf diesem Gerät."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso resumir seus saldos, próximas contas, tarefas pendentes e gastos do mês. Todas as respostas ficam neste dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高、今後の請求、未完了の家事、今月の支出をまとめます。すべての回答はこの端末内に保存されます。"
          }
        }
      }
    },
    "Everyone is settled.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos están al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les comptes sont réglés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Salden sind ausgeglichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as contas estão acertadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員精算済みです。"
          }
        }
      }
    },
    "No bills are due in the next 30 days.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay facturas con vencimiento en los próximos 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune facture n’arrive à échéance dans les 30 prochains jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den nächsten 30 Tagen sind keine Rechnungen fällig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma conta vence nos próximos 30 dias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後30日以内に期限を迎える請求はありません。"
          }
        }
      }
    },
    "There are no open chores.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tareas pendientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche n’est en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine offenen Aufgaben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há tarefas pendentes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了の家事はありません。"
          }
        }
      }
    },
    "No categories are over budget.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna categoría supera el presupuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune catégorie ne dépasse le budget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kategorie liegt über dem Budget."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma categoria está acima do orçamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算を超えているカテゴリーはありません。"
          }
        }
      }
    },
    "Try asking: Who owes whom? What bills are due? What chores are open? How much did we spend this month?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a preguntar: ¿Quién debe a quién? ¿Qué facturas vencen? ¿Qué tareas quedan? ¿Cuánto gastamos este mes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez : Qui doit de l’argent à qui ? Quelles factures arrivent à échéance ? Quelles tâches restent à faire ? Combien avons-nous dépensé ce mois-ci ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage zum Beispiel: Wer schuldet wem Geld? Welche Rechnungen sind fällig? Welche Aufgaben sind offen? Wie viel haben wir diesen Monat ausgegeben?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente perguntar: Quem deve a quem? Quais contas vencem? Quais tarefas estão pendentes? Quanto gastamos este mês?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例えば「誰が誰に払う？」「請求の期限は？」「残っている家事は？」「今月はいくら使った？」と聞いてみてください。"
          }
        }
      }
    },
